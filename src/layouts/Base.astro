---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/source-sans-3';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource-variable/noto-sans-khmer';
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title = `${site.name} · AI Builder`, description = site.description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);

// Tells search engines who this site is about. No phone or email here on purpose.
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: 'AI Builder',
  url: Astro.site?.href,
  address: { '@type': 'PostalAddress', addressLocality: 'Siem Reap', addressCountry: 'KH' },
  sameAs: [site.linkedin, site.github],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Apply a saved light/dark choice before the page paints, so it never flashes the wrong colours.
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}, ${site.role}`} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="page">
      <nav class="nav" aria-label="Site">
        <a class="home" href="/">{site.name}</a>
        <ul>
          <li><a href="/#work">Work</a></li>
          <li><a href="/#how">How I work</a></li>
          <li><a href="/#experience">Experience</a></li>
          <li><a href="/#contact">Contact</a></li>
          <li><a href={site.cv}>CV (PDF)</a></li>
        </ul>
        <button class="theme-toggle" type="button" hidden>
          <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="2" /><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
          <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /></svg>
        </button>
      </nav>
      <main id="main" class="sheet">
        <slot />
      </main>
      <footer class="foot">
        <span>{site.name} · Updated {site.updated}</span>
        <a href={site.repo}>Source code</a>
      </footer>
    </div>
    <script is:inline>
      // Light/dark switch. Starts from the visitor's device setting; a click flips it and remembers the
      // choice in this browser only (the word "light" or "dark", nothing else). Hidden if scripts are off.
      (() => {
        const root = document.documentElement;
        const button = document.querySelector('.theme-toggle');
        const dark = matchMedia('(prefers-color-scheme: dark)');
        const current = () => root.dataset.theme || (dark.matches ? 'dark' : 'light');
        const update = () => {
          const next = current() === 'dark' ? 'light' : 'dark';
          button.dataset.next = next;
          button.setAttribute('aria-label', `Switch to ${next} mode`);
          button.title = `Switch to ${next} mode`;
        };
        button.addEventListener('click', () => {
          root.dataset.theme = current() === 'dark' ? 'light' : 'dark';
          try { localStorage.setItem('theme', root.dataset.theme); } catch {}
          update();
        });
        dark.addEventListener('change', update);
        update();
        button.hidden = false;
      })();
    </script>
  </body>
</html>
